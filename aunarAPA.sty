%% Con esto ponemos el numero en la parte superior de la pagina a la derecha
\makeatletter
\renewcommand*{\ps@plain}{%
  \let\@mkboth\@gobbletwo
  \let\@oddfoot\@empty
  \def\@oddhead{%
    \reset@font
    \hfil
    \thepage
    % \hfil % removed for aligning to the right
  }%
  \let\@evenhead\@oddhead
  \let\@evenfoot\@empty
}
\makeatother
\pagestyle{plain}

%% Configuración de numero de pagina para landscape mode
\fancypagestyle{mylandscape}{
\fancyhf{} %Clears the header/footer
\fancyhead{% Footer
\makebox[\textwidth][r]{% Right
  \rlap{\hspace{-17cm}% Push out of margin by \footskip
    \smash{% Remove vertical height
      \raisebox{0cm}{% Raise vertically
        \rotatebox{90}{\thepage}}}}}}% Rotate counter-clockwise
\renewcommand{\headrulewidth}{0pt}% No header rule
\renewcommand{\footrulewidth}{0pt}% No footer rule
}

%%% configuración general para formato APA
