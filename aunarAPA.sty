%%%% Modificando el formato de los titulos
\titleformat{\chapter}[block]
  {\normalfont\normalsize\bfseries}{\thechapter .}{1ex}{\centering}
\titlespacing*{\chapter}{0pt}{-20pt}{10pt}

\titleformat{\section}[block]
  {\normalfont\normalsize\bfseries}{\thetitle .}{1ex}{}
  
% viejo formato de titulos
% \titleformat{\subsection}[block]
%   {\normalfont\normalsize\bfseries}{\hspace{1.27cm}\thetitle}{1em}{}
% \titleformat{\subsubsection}[block]
%   {\normalfont\normalsize\bfseries}{\hspace{2.54cm}\thetitle}{1em}{}
  
\titleformat{\subsection}[block]
  {\it\normalsize\bfseries}{\thetitle .}{1em}{}
  
\titleformat{\subsubsection}[runin]
{\normalfont\normalsize\bfseries}
{\hspace{1.27cm}\thetitle .}
{1ex}{}[.\quad]

\titleformat{\paragraph}[runin]
{\it\normalsize\bfseries}
{\hspace{1.27cm}\thetitle .}
{1ex}{}[.\quad]
  
%%%% Modificando el formato de para el caption de tablas

\titleformat{\table}[display]
  {\normalfont\normalsize\bfseries}{\thecontentslabel}{1em}{}
  
\captionsetup[table]{labelformat=simple, labelsep=newline, singlelinecheck=off,justification=raggedright}
\captionsetup[table]{labelfont=bf,textfont={it},font=doublespacing}

\captionsetup[figure]{labelformat=simple, labelsep=newline,
    singlelinecheck=off,justification=raggedright}
\captionsetup[figure]{labelfont=bf,textfont={it},font=doublespacing}
  
%% Configuración listas

\renewcommand{\labelitemi}{\textbullet}
\setlist{itemindent=0.4cm,leftmargin=1.27cm}